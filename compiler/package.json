{
	"name": "noteblock-compiler",
	"version": "0.3.1",
	"license": "MIT",
	"bin": {
		"nbc": "dist/main.js"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"chokidar": "^5.0.0",
		"lodash": "npm:lodash-es@^4.18.1",
		"ts-pattern": "^5.9.0",
		"typia": "^12.2.0",
		"yaml": "^2.9.0",
		"yargs": "^18.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/lodash": "^4.17.25",
		"@types/node": "^26.4.1",
		"@types/yargs": "^17.0.35",
		"@vitest/coverage-v8": "^5.0.0",
		"@vitest/ui": "^5.0.0",
		"ajv": "^8.20.0",
		"concurrently": "^10.0.5",
		"esbuild": "^0.28.2",
		"ts-arithmetic": "^0.1.1",
		"ts-patch": "^4.0.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	},
	"type": "module",
	"files": [
		"dist"
	],
	"scripts": {
		"prepare": "ts-patch install",
		"tscheck": "tsc",
		"build": "pnpm __compile && pnpm __bundle",
		"build:watch": "concurrently \"pnpm __compile --watch\" \"pnpm __bundle --watch\"",
		"__compile": "tsc -p tsconfig.build.json",
		"__bundle": "esbuild ./build/main.js --bundle --platform=node --format=esm --alias:@=./build --outfile=./dist/main.js --packages=external",
		"clean": "rm -rf dist build coverage",
		"test": "vitest run"
	}
}
